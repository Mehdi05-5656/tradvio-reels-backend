{
  "name": "tradvio-reels-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build-staging": "esbuild src/staging-readonly.ts --bundle --platform=node --format=cjs --outfile=dist/staging-readonly.cjs --external:ws",
    "start-staging": "node dist/staging-readonly.cjs",
    "check-staging": "node staging/cli.mjs",
    "test": "esbuild tests/*.test.ts --bundle --packages=external --platform=node --format=esm --outdir=.test-build && node --test .test-build/*.js",
    "build-handoff": "esbuild src/handoff-tick.ts --bundle --platform=node --format=cjs --outfile=dist/handoff-tick.cjs --external:ws",
    "handoff-tick": "node dist/handoff-tick.cjs",
    "build-generation": "esbuild src/generation-tick.ts --bundle --platform=node --format=cjs --outfile=dist/generation-tick.cjs --external:ws",
    "generation-tick": "node dist/generation-tick.cjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:pg-native --external:cardinal --external:@babel/preset-typescript --minify",
    "start": "node dist/index.cjs",
    "publisher-tick": "node dist/publisher-tick.cjs",
    "analytics-tick": "node dist/analytics-tick.cjs",
    "alert-tick": "node dist/alert-tick.cjs",
    "build-ticks": "esbuild src/publisher-tick.ts --bundle --platform=node --format=cjs --outfile=dist/publisher-tick.cjs --minify && esbuild src/analytics-tick.ts --bundle --platform=node --format=cjs --outfile=dist/analytics-tick.cjs --minify && esbuild src/alert-tick.ts --bundle --platform=node --format=cjs --outfile=dist/alert-tick.cjs --minify"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3"
  }
}
