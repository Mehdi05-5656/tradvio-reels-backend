FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
RUN npm run build-generation && npm prune --omit=dev
USER node
# A single bounded job per invocation. Orchestrator controls cadence/restarts.
# Deploy with CPU/memory limits, read-only root and bounded /tmp volume.
CMD ["node","dist/generation-tick.cjs"]
