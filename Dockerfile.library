FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY scripts/library-worker.py scripts/legacy-pool-rehearsal.py ./
RUN useradd --create-home renderworker
USER renderworker
ENV LIBRARY_RENDER_ENABLED=0 LIBRARY_MAX_JOBS=1
CMD ["python","library-worker.py"]
